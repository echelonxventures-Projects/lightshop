{
  "name": "@lightshop/catalog-service",
  "version": "0.1.0",
  "private": true,
  "description": "Catalog & PIM bounded context: products, offers, buy box, vertical-pack validation. Reference template for all services.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "SEED_DEMO=true tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@apollo/subgraph": "^2.11.0",
    "@as-integrations/express5": "^1.1.2",
    "@lightshop/adapters": "workspace:*",
    "@lightshop/contracts": "workspace:*",
    "@lightshop/domain-kernel": "workspace:*",
    "@lightshop/tenancy": "workspace:*",
    "@lightshop/vertical-packs": "workspace:*",
    "@nestjs/apollo": "^13.4.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/graphql": "^13.4.0",
    "@nestjs/platform-express": "^11.1.0",
    "graphql": "^16.11.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@lightshop/auth": "workspace:*",
    "@lightshop/observability": "workspace:*",
    "@lightshop/outbox": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "@lightshop/testing": "workspace:*"
  }
}
