{
  "name": "@lightshop/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Public GraphQL edge: composes subgraphs (Apollo Federation v2 spec, MIT runtime), resolves the white-label tenant, verifies tokens, rate-limits, enforces query limits.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@graphql-hive/gateway-runtime": "^2.12.0",
    "@graphql-mesh/transport-http": "^1.2.1",
    "@lightshop/auth": "workspace:*",
    "@lightshop/domain-kernel": "workspace:*",
    "@lightshop/graphql-security": "workspace:*",
    "@lightshop/observability": "workspace:*",
    "@lightshop/tenancy": "workspace:*",
    "@theguild/federation-composition": "^0.27.0",
    "graphql": "^16.11.0"
  },
  "devDependencies": {
    "@lightshop/testing": "workspace:*",
    "tsx": "^4.20.0",
    "@lightshop/catalog-service": "workspace:*"
  }
}
