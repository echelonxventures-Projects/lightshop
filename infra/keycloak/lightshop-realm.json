      "credentials": [
        {
          "type": "password",
          "value": "acme-admin",
          "temporary": false
        }
      ]
    },
    {
      "username": "gadgetco",
      "email": "ops@gadgetco.example",
      "firstName": "Gadget",
      "lastName": "Co",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "acme-mart"
        ],
        "seller_id": [
          "sel_gadgetco"
        ]
      },
      "realmRoles": [
        "seller"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "gadgetco",
          "temporary": false
        }
      ]
    },
    {
      "username": "raj",
      "email": "raj@verde.example",
      "firstName": "Raj",
      "lastName": "Buyer",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "verde-wholesale"
        ],
        "org_id": [
          "org_raj_traders"
        ]
      },
      "realmRoles": [
        "buyer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "raj",
          "temporary": false
        }
      ]
    },
    {
      "username": "ops",
      "email": "ops@lightshop.example",
      "firstName": "Platform",
      "lastName": "Ops",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "*"
        ]
      },
      "realmRoles": [
        "platform:admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "ops",
          "temporary": false
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ADMIN_VIEW\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"tenant_id\", \"displayName\": \"Store\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"seller_id\", \"displayName\": \"Seller account\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"org_id\", \"displayName\": \"Business organization\", \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": []}"
          ]
        }
      }
    ]
  }
}