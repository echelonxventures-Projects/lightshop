{
  "name": "@lightshop/observability",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTelemetry tracing + metrics bootstrap and trace-correlated JSON logging. Backend-agnostic (OTLP).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
