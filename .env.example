# Catalog service
CATALOG_DATABASE_URL=postgres://lightshop:lightshop@localhost:5432/catalog
CATALOG_PORT=4001
# Event bus adapter: kafka | memory
EVENT_BUS=kafka
KAFKA_BROKERS=localhost:9092
# Storefront
CATALOG_GRAPHQL_URL=http://localhost:4001/graphql

# Demo data (never in production; refused at boot when NODE_ENV=production)
SEED_DEMO=true
# Gateway/BFF trust: identity headers are honoured only from callers presenting this secret.
# Required (>= 32 chars) in production. Leave unset locally to trust headers (dev only).
# GATEWAY_SHARED_SECRET=
# Auth: dev tokens locally (pnpm dev:token ...). In production set OIDC_ISSUER (+ OIDC_AUDIENCE, OIDC_JWKS_URL).
DEV_AUTH_SECRET=lightshop-local-dev-secret
# OIDC_ISSUER=http://localhost:8080/realms/lightshop
# OIDC_AUDIENCE=lightshop
# OIDC_JWKS_URL=http://localhost:8080/realms/lightshop/protocol/openid-connect/certs
# GraphQL limits
GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_TOKENS=5000
